# Copy to .env.local for local dev. In production, set these in Vercel → Settings → Environment Variables.
# The full walkthrough (where each key comes from) is in the setup document.

# --- Database ------------------------------------------------------------------
# Local (docker-compose.yml):  postgresql://postgres:postgres@localhost:5432/pixilove
# Supabase: Project Settings → Database → Connection string
#   App runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixilove
#   Migrations/scripts: session pooler or direct (port 5432). Same as above locally.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pixilove

# --- Supabase (Project Settings → API) ---------------------------------------------
# Customer accounts (signup/login) need a Supabase project, even locally.
# For local dev, a free project is enough: set URL + anon key only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# File storage. Leave empty locally: uploads then go to ./.storage instead.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for buyers' photos (Storage → New bucket → Public OFF)
SUPABASE_PHOTOS_BUCKET=card-photos
# Public bucket for admin uploads: covers, demo photos, music (Public ON)
SUPABASE_ASSETS_BUCKET=site-assets

# --- Stripe (Developers → API keys / Webhooks) --------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Admin panel (/admin) -------------------------------------------------------------
# Any random string, 32+ characters. Generate: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Password reset emails are sent by Supabase Auth (see docs/setup/03-email.md).
# Optional: contact address shown on the forgot-password page and in the footer.
SUPPORT_EMAIL=

# --- Draft cleanup cron. Any random string; Vercel sends it automatically. -----------------
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
